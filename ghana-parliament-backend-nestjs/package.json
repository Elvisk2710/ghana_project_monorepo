{
  "name": "ghana-parliament-backend",
  "version": "1.0.0",
  "description": "Ghana Parliament AI Engagement Platform - backend API (NestJS + Prisma)",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "jest --config jest.config.js",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "loadtest": "node scripts/loadtest/run.mjs",
    "drill:dr": "node scripts/dr-drill.mjs",
    "security:audit": "npm audit --omit=dev",
    "drill:rollback": "node scripts/rollback-drill.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nestjs-cls": "^7.0.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "private": true
}
