# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://parliament:parliament_dev_only@localhost:5432/parliament?schema=public"

# Comma-separated allow-list of browser origins (public app, admin console). Required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Parliament identity provider (OIDC). JWKS URI defaults to <issuer>/.well-known/jwks.json
OIDC_ISSUER=https://idp.example.gov.gh/realms/parliament
OIDC_AUDIENCE=parliament-api
# OIDC_JWKS_URI=

# ---- Constituency engagement (Phase 3) ----
# Signs citizen tracking codes. REQUIRED in production, 32+ characters. Rotating it invalidates every code.
# CASE_TOKEN_SECRET=
# Provisional defaults pending Parliament's decisions (see Decisions sheet in the task tracker).
# Administrators can override these in the console (Settings); a value set there wins over these.
# CASE_RETENTION_DAYS=730
# CASE_SLA_HOURS=120
# CASE_SLA_URGENT_HOURS=24
# Notification delivery (citizens and staff). Unset = every delivery fails visibly.
#   log     writes messages to the log (development only; refused in production)
#   webhook posts JSON { channel, to, subject, body } to a delivery gateway (SMS aggregator, email API, relay)
#   smtp    sends email through an SMTP server; SMS is handed to the webhook gateway if one is configured
# NOTIFICATION_PROVIDER=log
# NOTIFICATION_WEBHOOK_URL=https://gateway.example/send   (https required in production)
# NOTIFICATION_WEBHOOK_TOKEN=
# NOTIFICATION_TIMEOUT_MS=10000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Parliament of Ghana <noreply@parliament.example>"
# Staff alerts (new/escalated cases, AI alerts, incidents) go to the people concerned by email. Set false to turn off.
# STAFF_ALERTS=true
# Link used in staff alerts, and extra operations mailboxes (comma-separated) that also receive AI alerts and incidents.
# ADMIN_APP_URL=https://admin.parliament.example
# OPS_ALERT_EMAILS=
# Base URL of the public app, used in notification text.
# PUBLIC_APP_URL=https://connect.parliament.example
# Optional ClamAV daemon for attachment scanning. If set and unreachable, uploads are refused.
# CLAMD_HOST=
# CLAMD_PORT=3310

# ---- AI governance (Phase 5) ----
# The database MUST be UTF-8 (/health/ready fails otherwise).
# A model is only used through an approved AI deployment (no environment switch). It also needs a provider key,
# and sends the redacted question and public passages to the provider: needs Parliament's data-residency decision first.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANSWER_TIMEOUT_MS=20000
# Quality and bias monitoring cadence (set JOBS_ENABLED=false to turn the background tasks off).
# MONITOR_INTERVAL_MS=300000
# MONITOR_WINDOW_MINUTES=60

# ---- Email-and-password sign-in (admin console) ----
# Set to a random 32+ character string to enable POST /api/v1/auth/login. Unset = SSO (OIDC) only.
# Create the first user after a build: node --env-file=.env scripts/create-user.mjs admin@example.gov.gh "Name" "a-long-password" ADMIN
# LOCAL_AUTH_SECRET=
# LOCAL_AUTH_TTL_MINUTES=480
